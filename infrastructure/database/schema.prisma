// ============================================================
//  AI CHARACTER VIDEO STUDIO PRO — schema.prisma
//  Phase 1 · Schritt 2: Vollständiges Datenbankdesign
//  13 Tabellen · PostgreSQL · Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. USERS
// ============================================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          UserRole  @default(CREATOR)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationen
  characters    Character[]
  stories       Story[]
  videos        Video[]
  generations   Generation[]
  voiceProfiles VoiceProfile[]
  renderJobs    RenderJob[]
  settings      Settings?
  auditLogs     AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  CREATOR
  VIEWER
}

// ============================================================
// 2. CHARACTERS — Kernmodell der Plattform
// ============================================================
model Character {
  id              String          @id @default(cuid())
  userId          String
  name            String
  description     String?
  species         String?         // Mensch, Tier, Fantasy usw.
  gender          String?
  age             Int?
  style           String?         // Realistisch, Anime, Cartoon
  isLocked        Boolean         @default(false)  // Character Lock Engine
  thumbnailUrl    String?
  referenceImages String[]        // URLs der Referenzbilder
  tags            String[]
  isPublic        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relationen
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         CharacterProfile?
  embeddings      CharacterEmbedding[]
  voiceProfile    VoiceProfile?
  sceneCharacters SceneCharacter[]
  generations     Generation[]

  @@index([userId])
  @@index([isLocked])
  @@map("characters")
}

// ============================================================
// 3. CHARACTER EMBEDDINGS — Vektordaten für KI-Konsistenz
// ============================================================
model CharacterEmbedding {
  id              String        @id @default(cuid())
  characterId     String
  type            EmbeddingType
  // Vektor-IDs in Qdrant (Embeddings selbst liegen in Qdrant)
  qdrantId        String        @unique
  qdrantCollection String
  // Dimensionen zur Kontrolle
  dimensions      Int
  modelUsed       String        // z.B. "insightface-buffalo-l"
  score           Float?        // Qualitäts-Score der Extraktion
  metadata        Json?         // Zusätzliche Metadaten
  createdAt       DateTime      @default(now())

  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([type])
  @@map("character_embeddings")
}

enum EmbeddingType {
  FACE          // InsightFace / ArcFace — 512d
  STYLE         // CLIP — 768d
  BODY          // DINOv2 — 1024d
  IDENTITY      // InstantID / PuLID tokens
  IP_ADAPTER    // IP-Adapter image prompt embeddings
}

// ============================================================
// 4. CHARACTER PROFILES — DNA-Profil & Persönlichkeit
// ============================================================
model CharacterProfile {
  id                String    @id @default(cuid())
  characterId       String    @unique

  // Physische Merkmale (von Florence-2 / Qwen2.5-VL analysiert)
  skinColor         String?
  hairColor         String?
  eyeColor          String?
  furColor          String?   // für Tiere
  bodyType          String?
  height            String?
  distinctiveFeatures String[]

  // Kleidung & Accessoires
  primaryOutfit     Json?     // { top, bottom, shoes, colors[] }
  accessories       String[]
  clothingStyle     String?

  // Persönlichkeit (für Story Generator)
  personality       String[]  // ["mutig", "neugierig", "freundlich"]
  backstory         String?
  catchPhrase       String?
  quirks            String[]
  relationships     Json?     // { "Charakter B": "Freund", ... }
  favoriteObjects   String[]

  // Technische KI-Parameter
  ipAdapterWeight   Float     @default(0.8)  // Stärke des Character Lock
  consistencyScore  Float?    // Wie konsistent ist der Charakter
  analysisVersion   String    @default("1.0")
  rawAnalysis       Json?     // Rohe Ausgabe der Bildanalyse

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_profiles")
}

// ============================================================
// 5. STORIES
// ============================================================
model Story {
  id            String      @id @default(cuid())
  userId        String
  title         String
  logline       String?     // Einzeiliger Story-Pitch
  genre         String?
  targetLength  Int         @default(10)  // Anzahl Szenen
  status        StoryStatus @default(DRAFT)
  llmModel      String?     // Welches LLM wurde verwendet
  generationPrompt String?  // Ursprüngliche Nutzer-Idee
  outline       Json?       // { acts[], themes[], ... }
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes        Scene[]
  videos        Video[]

  @@index([userId])
  @@index([status])
  @@map("stories")
}

enum StoryStatus {
  DRAFT
  GENERATING
  READY
  IN_PRODUCTION
  COMPLETED
  ARCHIVED
}

// ============================================================
// 6. SCENES — Einzelszenen einer Story
// ============================================================
model Scene {
  id                String          @id @default(cuid())
  storyId           String
  order             Int             // Reihenfolge in der Story
  title             String
  description       String?
  dialogue          String?
  voiceOverText     String?

  // KI-generierte Prompts
  characterPrompt   String?
  scenePrompt       String?
  cameraPrompt      String?
  motionPrompt      String?
  environmentPrompt String?
  lightingPrompt    String?
  negativePrompt    String?

  // Kamera & Timing
  cameraType        String?   // "dolly", "static", "tracking"
  duration          Int       @default(5)  // Sekunden
  transitionType    String?

  // Status
  status            SceneStatus @default(PENDING)
  thumbnailUrl      String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  story             Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sceneCharacters   SceneCharacter[]
  videos            Video[]
  generations       Generation[]

  @@index([storyId])
  @@index([order])
  @@map("scenes")
}

enum SceneStatus {
  PENDING
  READY
  RENDERING
  COMPLETED
  FAILED
}

// ============================================================
// JUNCTION: Scene ↔ Character (N:M)
// ============================================================
model SceneCharacter {
  id          String    @id @default(cuid())
  sceneId     String
  characterId String
  role        String?   // "Protagonist", "Antagonist", "Nebenfigur"
  action      String?   // Was tut der Charakter in dieser Szene

  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
  @@map("scene_characters")
}

// ============================================================
// 7. VIDEOS
// ============================================================
model Video {
  id            String       @id @default(cuid())
  userId        String
  storyId       String?
  sceneId       String?
  title         String
  description   String?
  status        VideoStatus  @default(PENDING)

  // Technische Parameter
  resolution    String       @default("1080p")  // 720p|1080p|2K|4K
  fps           Int          @default(24)
  duration      Float?       // Dauer in Sekunden
  fileFormat    String       @default("mp4")   // mp4|mov|webm
  fileSize      BigInt?      // Dateigröße in Bytes
  filePath      String?      // Pfad zur fertigen Videodatei
  thumbnailUrl  String?

  // Render-Metadaten
  videoModel    String?      // z.B. "wan2.2"
  imageModel    String?      // z.B. "flux-dev"
  renderTime    Int?         // Sekunden bis Fertigstellung

  // Social Media Export
  exportedTo    String[]     // ["tiktok", "youtube-shorts", ...]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  story         Story?       @relation(fields: [storyId], references: [id])
  scene         Scene?       @relation(fields: [sceneId], references: [id])
  versions      VideoVersion[]
  renderJobs    RenderJob[]

  @@index([userId])
  @@index([status])
  @@map("videos")
}

enum VideoStatus {
  PENDING
  QUEUED
  RENDERING
  POST_PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

// ============================================================
// 8. VIDEO VERSIONS — Versionshistorie
// ============================================================
model VideoVersion {
  id          String    @id @default(cuid())
  videoId     String
  version     Int
  filePath    String
  fileSize    BigInt?
  changeNote  String?
  renderParams Json?   // Alle Render-Parameter dieser Version
  createdAt   DateTime @default(now())

  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, version])
  @@index([videoId])
  @@map("video_versions")
}

// ============================================================
// 9. VOICE PROFILES
// ============================================================
model VoiceProfile {
  id              String    @id @default(cuid())
  userId          String
  characterId     String?   @unique
  name            String
  language        String    @default("de")
  model           String    @default("xtts-v2")  // xtts-v2|kokoro|orpheus
  // Pfad zur Referenzaudio-Datei für Cloning
  referencePath   String?
  // XTTS speaker embedding in Qdrant
  speakerEmbeddingId String?
  // Stimm-Parameter
  speed           Float     @default(1.0)
  pitch           Float     @default(0.0)
  energy          Float     @default(1.0)
  // Unterstützte Emotionen
  emotions        String[]  @default(["neutral"])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character       Character? @relation(fields: [characterId], references: [id])
  generations     Generation[]

  @@index([userId])
  @@map("voice_profiles")
}

// ============================================================
// 10. GENERATIONS — Jede einzelne KI-Generierung
// ============================================================
model Generation {
  id              String          @id @default(cuid())
  userId          String
  characterId     String?
  sceneId         String?
  voiceProfileId  String?
  type            GenerationType
  status          GenerationStatus @default(PENDING)

  // Input
  prompt          String
  negativePrompt  String?
  parameters      Json            // Alle KI-Parameter

  // Output
  outputPath      String?
  outputType      String?         // "image"|"video"|"audio"
  metadata        Json?

  // Performance
  modelUsed       String?
  gpuUsed         String?
  inferenceTime   Float?          // Sekunden
  seed            BigInt?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  character       Character?      @relation(fields: [characterId], references: [id])
  scene           Scene?          @relation(fields: [sceneId], references: [id])
  voiceProfile    VoiceProfile?   @relation(fields: [voiceProfileId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("generations")
}

enum GenerationType {
  IMAGE
  VIDEO
  VOICE
  STORY
  EMBEDDING
}

enum GenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================
// 11. RENDER JOBS — BullMQ Job-Tracking
// ============================================================
model RenderJob {
  id            String        @id @default(cuid())
  userId        String
  videoId       String?
  jobId         String        @unique  // BullMQ Job ID
  queue         String        @default("render")
  status        JobStatus     @default(WAITING)
  priority      Int           @default(0)

  // Fortschritt
  progress      Int           @default(0)  // 0-100
  currentStep   String?
  steps         Json?         // Array aller Schritte mit Status

  // Ergebnis
  result        Json?
  errorMessage  String?
  errorStack    String?

  // Zeiten
  startedAt     DateTime?
  completedAt   DateTime?
  estimatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video         Video?        @relation(fields: [videoId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([jobId])
  @@map("render_jobs")
}

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
  CANCELLED
}

// ============================================================
// 12. SETTINGS — Benutzer- und Systemeinstellungen
// ============================================================
model Settings {
  id              String    @id @default(cuid())
  userId          String    @unique

  // KI-Modell-Präferenzen
  defaultVideoModel   String  @default("wan2.2")
  defaultImageModel   String  @default("flux-dev")
  defaultLlmModel     String  @default("qwen3")
  defaultVoiceModel   String  @default("xtts-v2")

  // Render-Standardwerte
  defaultResolution   String  @default("1080p")
  defaultFps          Int     @default(24)
  defaultFormat       String  @default("mp4")
  defaultDuration     Int     @default(5)

  // GPU-Einstellungen
  gpuDevices          String[] @default(["0"])
  maxVramGb           Int      @default(24)
  tensorrtEnabled     Boolean  @default(false)
  mixedPrecision      Boolean  @default(true)

  // Speicher
  outputPath          String   @default("./storage/outputs")
  uploadPath          String   @default("./storage/uploads")
  autoCleanupDays     Int      @default(30)

  // UI-Präferenzen
  language            String   @default("de")
  theme               String   @default("dark")
  notificationsEnabled Boolean @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ============================================================
// 13. AUDIT LOGS — Alle Aktionen protokollieren
// ============================================================
model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  action      String    // "character.create", "video.render.start" usw.
  entityType  String?   // "Character", "Video", "Story"
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?     // Zusätzliche Kontextdaten
  severity    LogLevel  @default(INFO)
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}
